# Copy to .env.local and fill in. Never commit real values.

# Local: `npm run db:local`. On Vercel the Neon integration sets this automatically.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54320/postgres

# Auth.js. Generate a secret with: npx auth secret
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated GitHub logins allowed to sign in as owner
OWNER_GITHUB_LOGINS=
# Local only: adds a "Development login" button under `npm run dev`. Never set on Vercel.
AUTH_DEV_LOGIN=

# GitHub App (M3), see docs/github-app.md
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Vercel Cron calls /api/cron/dispatch with this secret (M4)
CRON_SECRET=

# Vercel deployments are read from GitHub deployment_status events; no Vercel token needed.
